# CLARION Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# Database Configuration (SQLite default for zero-setup, PostgreSQL optional)
DATABASE_URL=sqlite:///./clarion.db

# IBM watsonx.ai (Optional: CLARION runs in high-fidelity DEMO mode if absent)
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Operational Parameters
CORRELATION_WINDOW_MINUTES=30
AI_MODE=DEMO
